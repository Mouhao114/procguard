{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build (g++)",
      "type": "cppbuild",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-g",
        "-O0",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "detail": "g++ -std=c++17 -Wall -Wextra -g，编译当前文件"
    }
  ]
}
